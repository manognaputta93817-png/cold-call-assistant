# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI (get from aistudio.google.com → Get API Key)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name — must be supported by the @google/genai SDK
# Official stable model list: https://ai.google.dev/gemini-api/docs/models
# Default: gemini-3.8-flash (confirmed available and recommended by the API)
# Alternatives: gemini-2.5-flash-lite, gemini-2.5-pro, gemini-3.6-flash
GEMINI_MODEL=gemini-3.8-flash

# Frontend URL for CORS (Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# AI Provider (gemini | mock)
AI_PROVIDER=gemini
