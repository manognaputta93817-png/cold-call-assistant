# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI (get from aistudio.google.com → Get API Key)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name (default: gemini-2.0-flash — change only if you need a different model)
# Supported models: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Frontend URL for CORS (Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# AI Provider (gemini | mock)
AI_PROVIDER=gemini
